					$(selectorWrap).addClass("active");
					$(selectorWrap).attr("aria-selected", "true").next(".view-conts").attr("aria-expanded", "true");
					$(selectorWrap).find(".view-conts").slideDown(200);
				} else {
					$(selectorWrap).removeClass("active");
					$(selectorWrap).attr("aria-selected", "false").next(".view-conts").attr("aria-expanded", "false");
