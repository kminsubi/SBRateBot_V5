	/* 상환금액 계산 */
	function calcValue(){
		
		var term = Number($("#loanTerm").val()); //개월
		var indi = Number($("#indi").val()); //상환방법 - 0:만기일시상환, 1:원금균등상환, 2:원리금균등상환, 3:마이너스통장
		var amt = Number($("#proPrice").val().replace(/[^\d]/g,"")); //금액
		rate = parseFloat(rate) / 100.0; //연이율
		
		if(amt == 1 ) amt = amt * 10000;

		var cap_amt = 0;
		var int_amt = 0;
		var ci_amt = 0;
		var pay_amt = 0;
		var loan_bal = amt;
		var int_amt_sum = 0;
		
		var payMsg = "매월 상환금액은";
		if ( "LL" == "E") {
			payMsg = "매월납부이자(30일기준)";
		}
		
		if( existNull(rate)	 || existNull(amt)) {
			$('.repayment').text('-');
			
		}else{
			 for (var i = 0; i < term; i++) { // 원금일시상황
				 if (indi == 0) { //만기일시상환
 					int_amt = Number(loan_bal) * 30 / 365 * parseFloat(rate); // 1회불입금 
//  					int_amt = Number(loan_bal) * 31 / 365 * parseFloat(rate); // 1회불입금 * 31 / 365 * 이율 KB ASIS
 					int_amt_sum = Number(int_amt_sum) + Number(int_amt);
 					var strAmt = int_amt_sum / term;
					ci_amt = Math.floor( strAmt * 10000);	
					
				 } else if ( indi == 1) { // 원금균등상환
					 int_amt = Number(loan_bal) * 30 / 365 * parseFloat(rate); // 1회불입금  
// 					int_amt = Number(loan_bal) * 30 / 360 * parseFloat(rate); // 1회불입금 
// 					int_amt = Number(loan_bal) * 31 / 365 * parseFloat(rate); // 1회불입금 * 31 / 365 * 이율 ASIS
					
					if ( i == term - 1) {
						loan_bal = Number(loan_bal) - Number(cap_amt);
						cap_amt = amt / term + Number(loan_bal);
						loan_bal = 0;
						
					} else {
						cap_amt = amt / term;
						loan_bal = Number(loan_bal) - Number(cap_amt);
					} // 이자합계
					
					int_amt_sum = Number(int_amt_sum) + Number(int_amt);
					pay_amt = Number(pay_amt) + Number(cap_amt); //원금균등상환의 ci_amt:첫달상환금액
					ci_amt = ( amt / term) + (amt * parseFloat(rate) * 30 / 365.0); //
// 					ci_amt = ( amt / term) + (amt * parseFloat(rate) * 30 / 360.0); //
// 					ci_amt = ( amt / term) + (amt * parseFloat(rate) * 31 / 365.0); ASIS
					ci_amt = Math.floor(ci_amt*10000);
					
				} else if ( indi == 2) { // 원리금균등상환
					

					ci_amt = (Number(amt)
							* parseFloat(rate)
							/ 12
							* Math.pow( (1 + parseFloat(rate) / 12),
									Number(term)) / (Math.pow(
											 (1 + parseFloat(rate) /12 ), Number(term)) - 1)); // 원리금
					ci_amt = Math.round(ci_amt*10000); // 이자
					
					
					/* 
			 		ci_amt = (Number(amt)
							* parseFloat(rate)
							* 30
							/ 360.0
							* Math.pow( (1 + parseFloat(rate) * 30 / 360.0),
									Number(term)) / (Math.pow(
											 (1 + parseFloat(rate) * 30 / 360.0), Number(term)) - 1)); // 원리금
					ci_amt = Math.round(ci_amt*10000); // 이자
					 */
					
				}else if ( indi == 3) { // 마이너스통장
					//비상금 대출일 경우 마이너스통장 신규추가
					
				} // end else
			}

			$('#payMsg').text ( payMsg);
			$('.repayment').text(customComma(ci_amt.toString()));
		}	
	}
	
	function existNull( str){
		if ( str == null || str == undefined || str == "" || str == "0") {
			return true;
		}
		
		return false;		
