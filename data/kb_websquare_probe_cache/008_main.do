			/* 1 상단 공지 바 */
			(function initMainNoticeRolling() {
				var $notice = $('.main-notice');
				if (!$notice.length) return;
				if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

				var $viewport = $notice.find('.notice-roll-viewport');
				var $track = $notice.find('.notice-roll-track');
				var $items = $track.children('li');
				if ($items.length <= 1) return;

				$track.append($items.eq(0).clone(true));
				var total = $items.length;
				var index = 0;
				var timer = null;
				var rowHeight = $viewport.outerHeight();

				function refreshHeight() {
					rowHeight = $viewport.outerHeight();
					$track.css('transform', 'translateY(' + -index * rowHeight + 'px)');
				}

				function stopRolling() {
					if (!timer) return;
					clearInterval(timer);
					timer = null;
				}

				function startRolling() {
					stopRolling();
					timer = setInterval(function () {
						index += 1;
						$track.addClass('is-animating').css('transform', 'translateY(' + -index * rowHeight + 'px)');
						if (index === total) {
							setTimeout(function () {
								$track.removeClass('is-animating');
								index = 0;
								$track.css('transform', 'translateY(0)');
							}, 400);
						}
					}, 2900);
				}

				$notice.on('mouseenter.mainNotice focusin.mainNotice touchstart.mainNotice', function () {
					stopRolling();
				});
				$notice.on('mouseleave.mainNotice focusout.mainNotice touchend.mainNotice', function () {
					startRolling();
				});

				$(window).on('resize.mainNoticeRolling', refreshHeight);
				refreshHeight();
				startRolling();

				$notice.data('mainNoticeStopRolling', stopRolling);
			})();

			$('.main-notice-close').on('click', function () {
				var $bar = $(this).closest('.main-notice');
				var stop = $bar.data('mainNoticeStopRolling');
				if (typeof stop === 'function') stop();
				$bar.off('.mainNotice');
				$(window).off('resize.mainNoticeRolling');
				$bar.slideUp(200);
			});

			/* 5 추천상품 (탭 + 카드) */
			(function () {
				var $section = $('.main-recmd');
				if (!$section.length) return;
				var $tabs = $section.find('.main-tab');
				var $panels = $section.find('.main-recmd-panel');
				if (!$tabs.length || !$panels.length || $tabs.length !== $panels.length) return;

				function activate(index) {
					$tabs.each(function (i) {
						var on = i === index;
						$(this).toggleClass('is-active', on).attr('aria-selected', on ? 'true' : 'false');
					});
					$panels.each(function (i) {
						var on = i === index;
						$(this).toggleClass('is-active', on);
						if (on) $(this).removeAttr('hidden');
						else $(this).attr('hidden', 'hidden');
					});
				}

				$tabs.on('click', function () {
					var idx = $tabs.index(this);
					if (idx < 0) return;
					activate(idx);
				});
			})();

			/* 6 하단 프로모션 슬라이드 */
			$('.main-promo .promotion-swiper').each(function () {
				var $swiper = $(this);
				if ($swiper.hasClass('swiper-container-initialized')) return;
				var paginationEl = $swiper.find('.swiper-pagination')[0];

				new Swiper(this, {
					slidesPerView: 1,
					spaceBetween: 20,
					pagination: {
						el: paginationEl,
						clickable: true
					}
				});
			});
		});

