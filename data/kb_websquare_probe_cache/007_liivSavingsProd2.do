    class SSInput {
        constructor(el) {
            this.wrap = el;
            this.input = this.wrap.querySelector('.ss-inp-txt');
            this.delBtn = this.wrap.querySelector('.ss-del');
            this.bindEvents();
        }
        bindEvents() {
            // 입력 감지 → 값 있으면 show, 없으면 제거
            this.input.addEventListener('input', () => this.toggleDelBtn());
            // 삭제 버튼 클릭 → 값 제거
            this.delBtn.addEventListener('click', () => this.clearInput());
        }
        toggleDelBtn() {
        	$('#RCMR_NO').val('');
        	console.log('RCMR_NO 비우기');
        	if (this.input.value.trim() !== '') {
                this.delBtn.classList.add('show');
            } else {
                this.delBtn.classList.remove('show');
            }
        }
        clearInput() {
        	$('#RCMR_NO').val('');
        	console.log('RCMR_NO 비우기');
        	this.input.value = '';
            this.delBtn.classList.remove('show');
            this.input.focus(); // 다시 입력 포커스 (선택사항)
        }
    }
    // 초기화 (모든 .ss-input 적용)
    document.querySelectorAll('.ss-input').forEach(el => new SSInput(el));
    
	(function initTabSwitch() {
        const buttons = document.querySelectorAll('.ss-btn-btn');
        const contents = document.querySelectorAll('.ss-cont');

        buttons.forEach((btn, idx) => {
            btn.addEventListener('click', () => {
                // 1. 모든 버튼 active 제거
                buttons.forEach(b => b.classList.remove('active'));

                // 2. 현재 클릭한 버튼 active 추가
                btn.classList.add('active');

                // 3. 모든 콘텐츠 active 제거
                contents.forEach(c => c.classList.remove('active'));

                // 4. 클릭한 버튼 index에 맞는 콘텐츠 활성화
                contents[idx].classList.add('active');
                
