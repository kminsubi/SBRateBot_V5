//직원 추천인선택
function setRecommendHd(empNo, rfGubun, name, dept) {
	// url 셋팅 정보
	$("#RCMR_NO").val(empNo);
	$("#RCMR_TYPE").val(rfGubun);
	
	// 직원추천인 정보 셋팅
	$('#recommHd').val(name+"-"+dept);
	// 고객추천인 정보 초기화
	$('#recomm2Hd').val('');
	UI.layerPopClose('#recommendedHd');
}
